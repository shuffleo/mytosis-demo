{
  "name": "2026-offsite-ai-design-excercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "capture": "node tests/capture-clustering.mjs",
    "preview": "vite preview",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build && wrangler deploy --strict"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@tweakpane/core": "^2.0.5",
    "paper": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  }
}
